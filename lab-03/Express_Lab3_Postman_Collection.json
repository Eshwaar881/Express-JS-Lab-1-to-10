{
  "info": {
    "name": "Express Lab 3 - Clean REST API with Filtering, Sorting, Validation, and Debugging",
    "description": "Postman Collection for Express Lab 3 covering RESTful CRUD, query filters (search_q, order_by, order, limit, offset, min_price, max_price), request body validation, and standard HTTP status codes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. GET /books - All Books (Default Parameters)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": ["{{baseUrl}}"],
          "path": ["books"]
        }
      }
    },
    {
      "name": "02. GET /books - Search with LIKE (?search_q=Gatsby)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books?search_q=Gatsby",
          "host": ["{{baseUrl}}"],
          "path": ["books"],
          "query": [
            { "key": "search_q", "value": "Gatsby" }
          ]
        }
      }
    },
    {
      "name": "03. GET /books - Sorting (?order_by=price&order=DESC&limit=4)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books?order_by=price&order=DESC&limit=4",
          "host": ["{{baseUrl}}"],
          "path": ["books"],
          "query": [
            { "key": "order_by", "value": "price" },
            { "key": "order", "value": "DESC" },
            { "key": "limit", "value": "4" }
          ]
        }
      }
    },
    {
      "name": "04. GET /books - Price Range Filter (?min_price=250&max_price=350)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books?min_price=250&max_price=350",
          "host": ["{{baseUrl}}"],
          "path": ["books"],
          "query": [
            { "key": "min_price", "value": "250" },
            { "key": "max_price", "value": "350" }
          ]
        }
      }
    },
    {
      "name": "05. GET /books - Pagination (?limit=2&offset=2)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books?limit=2&offset=2",
          "host": ["{{baseUrl}}"],
          "path": ["books"],
          "query": [
            { "key": "limit", "value": "2" },
            { "key": "offset", "value": "2" }
          ]
        }
      }
    },
    {
      "name": "06. GET /books/:bookId - Single Book by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/1",
          "host": ["{{baseUrl}}"],
          "path": ["books", "1"]
        }
      }
    },
    {
      "name": "07. POST /books - Validation Error 400 (Missing Title)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"author\": \"Unknown Author\",\n  \"price\": 199\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": ["{{baseUrl}}"],
          "path": ["books"]
        }
      }
    },
    {
      "name": "08. POST /books - Validation Error 400 (Non-Numeric Price)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Clean Code\",\n  \"author\": \"Robert C. Martin\",\n  \"price\": \"Free\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": ["{{baseUrl}}"],
          "path": ["books"]
        }
      }
    },
    {
      "name": "09. POST /books - Create New Book (201 Created)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Clean Code\",\n  \"author\": \"Robert C. Martin\",\n  \"price\": 450,\n  \"pages\": 464\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": ["{{baseUrl}}"],
          "path": ["books"]
        }
      }
    },
    {
      "name": "10. PUT /books/:bookId - Update Existing Book (200 OK)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Clean Code (2nd Edition)\",\n  \"author\": \"Robert C. Martin\",\n  \"price\": 499,\n  \"pages\": 480\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/books/11",
          "host": ["{{baseUrl}}"],
          "path": ["books", "11"]
        }
      }
    },
    {
      "name": "11. PUT /books/:bookId - Non-Existent Book (404 Not Found)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Ghost Book\",\n  \"author\": \"Nobody\",\n  \"price\": 100\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/books/99999",
          "host": ["{{baseUrl}}"],
          "path": ["books", "99999"]
        }
      }
    },
    {
      "name": "12. DELETE /books/:bookId - Delete Book (200 OK)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/11",
          "host": ["{{baseUrl}}"],
          "path": ["books", "11"]
        }
      }
    },
    {
      "name": "13. GET /books/:bookId - Verify Deleted (404 Not Found)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/11",
          "host": ["{{baseUrl}}"],
          "path": ["books", "11"]
        }
      }
    }
  ]
}

